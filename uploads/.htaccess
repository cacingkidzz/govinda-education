# Upload hanya boleh berisi file statis. Eksekusi skrip diblokir.
<IfModule mod_autoindex.c>
    Options -Indexes
</IfModule>
<IfModule mod_mime.c>
    RemoveHandler .php .phtml .php3 .php4 .php5 .php7 .php8 .phar .pl .py .cgi .sh
    RemoveType .php .phtml .php3 .php4 .php5 .php7 .php8 .phar
</IfModule>
<FilesMatch "\.(php|phtml|php3|php4|php5|php7|php8|phar|pl|py|cgi|sh|asp|aspx|jsp)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>
